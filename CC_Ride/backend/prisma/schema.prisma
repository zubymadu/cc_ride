  escalatedToId      String?        @map("escalated_to") @db.Uuid
  // Expiry
  expiresAt          DateTime       @map("expires_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  booking     Booking          @relation(fields: [bookingId], references: [id])
  requester   User             @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver    User?            @relation("ApprovalDecider", fields: [approverId], references: [id])
  escalatedTo User?            @relation("ApprovalEscalation", fields: [escalatedToId], references: [id])

  @@index([approverId, status])
  @@index([bookingId])
  @@map("approval_requests")
}

// =============================================================================
// RIDE POLICIES
// =============================================================================

model RidePolicy {
  id                    BigInt   @id @default(autoincrement())
  companyId             String   @map("company_id") @db.Uuid
  branchId              BigInt?  @map("branch_id")
  departmentId          BigInt?  @map("department_id")
  name                  String
  allowedDays           Int[]    @map("allowed_days") // 1=Mon…7=Sun; empty = all days
  allowedTimeFrom       String?  @map("allowed_time_from") // "HH:MM" in Africa/Lagos
  allowedTimeTo         String?  @map("allowed_time_to")
  allowedVehicleTypeIds Int[]    @map("allowed_vehicle_types") // empty = any type
  maxVehicleTypeId      BigInt?  @map("max_vehicle_type_id")
  maxFarePerTrip        Decimal? @map("max_fare_per_trip") @db.Decimal(15, 2)
  maxMonthlySpend       Decimal? @map("max_monthly_spend") @db.Decimal(15, 2)
  advanceBookingMinutes Int?     @map("advance_booking_minutes")
  extraRules            Json     @default("{}") @map("extra_rules")
  isActive              Boolean  @default(true) @map("is_active")
  createdById           String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         CompanyBranch? @relation(fields: [branchId], references: [id])
  department     Department?    @relation(fields: [departmentId], references: [id])
  createdBy      User           @relation("PolicyCreator", fields: [createdById], references: [id])
  maxVehicleType VehicleType?   @relation(fields: [maxVehicleTypeId], references: [id])

  @@map("ride_policies")
}

// =============================================================================
// INVOICES & RECEIPTS
// =============================================================================

model RideReceipt {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String          @unique @map("booking_id") @db.Uuid
  companyId          String?         @map("company_id") @db.Uuid
  employeeId         String          @map("employee_id") @db.Uuid
  departmentId       BigInt?         @map("department_id")
  costCentreId       BigInt?         @map("cost_centre_id")
  // Amounts (NGN)
  baseFare           Decimal         @map("base_fare") @db.Decimal(15, 2)
  platformFee        Decimal         @map("platform_fee") @db.Decimal(15, 2)
  discount           Decimal         @default(0.00) @db.Decimal(15, 2)
  totalCharged       Decimal         @map("total_charged") @db.Decimal(15, 2)
  // Trip
  originAddress      String          @map("origin_address")
  destinationAddress String          @map("destination_address")
  distanceKm         Decimal?        @map("distance_km") @db.Decimal(8, 2)
  durationMinutes    Int?            @map("duration_minutes")
  rideStartedAt      DateTime?       @map("ride_started_at")
  rideCompletedAt    DateTime?       @map("ride_completed_at")
  // Payment
  paymentReference   String?         @map("payment_reference")
  paymentGateway     PaymentGateway? @map("payment_gateway")
  // Receipt number (auto-generated by DB trigger or application layer)
  receiptNumber      String          @unique @map("receipt_number")
  pdfUrl             String?         @map("pdf_url")
  issuedAt           DateTime        @default(now()) @map("issued_at")

  booking      Booking           @relation(fields: [bookingId], references: [id])
  company      Company?          @relation(fields: [companyId], references: [id])
  employee     User              @relation(fields: [employeeId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  costCentre   CostCentre?       @relation(fields: [costCentreId], references: [id])
  invoiceItems InvoiceLineItem[]

  @@index([companyId])
  @@map("ride_receipts")
}

model Invoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         BigInt?   @map("branch_id") // null = company-level invoice
  invoiceNumber    String    @unique @map("invoice_number")
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  // Amounts (NGN)
  subtotal         Decimal   @db.Decimal(15, 2)
  vatRate          Decimal   @default(7.50) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount        Decimal   @map("vat_amount") @db.Decimal(15, 2)
  totalAmount      Decimal   @map("total_amount") @db.Decimal(15, 2)
  // Status
  isPaid           Boolean   @default(false) @map("is_paid")
  paidAt           DateTime? @map("paid_at")
  paymentReference String?   @map("payment_reference")
  dueDate          DateTime  @map("due_date") @db.Date
  pdfUrl           String?   @map("pdf_url")
  notes            String?
  generatedById    BigInt?   @map("generated_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  company     Company           @relation(fields: [companyId], references: [id])
  branch      CompanyBranch?    @relation(fields: [branchId], references: [id])
  generatedBy AdminUser?        @relation(fields: [generatedById], references: [id])
  lineItems   InvoiceLineItem[]

  @@index([companyId, periodStart])
  @@index([branchId, periodStart])
  @@map("invoices")
}

model InvoiceLineItem {
  id             BigInt    @id @default(autoincrement())
  invoiceId      String    @map("invoice_id") @db.Uuid
  receiptId      String?   @map("receipt_id") @db.Uuid
  description    String
  departmentName String?   @map("department_name")
  costCentre     String?   @map("cost_centre")
  employeeName   String?   @map("employee_name")
  quantity       Int       @default(1)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(15, 2)
  totalPrice     Decimal   @map("total_price") @db.Decimal(15, 2)
  rideDate       DateTime? @map("ride_date") @db.Date

  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt RideReceipt? @relation(fields: [receiptId], references: [id])

  @@map("invoice_line_items")
}

// =============================================================================
// PRICING ENGINE
//
// Fares are never hard-coded — every ride resolves its rate by layering
// PricingRateCard rows at lookup time: time_window > company > vehicle_type
// > global, each layer overriding only the fields it sets. Rows are never
// edited in place (see effectiveFrom/effectiveTo) so a ride already booked
// keeps recomputing against the rate card that was live when it was booked,
// not whatever a super-admin changes afterwards.
// =============================================================================

enum PricingScope {
  global
  vehicle_type
  company
  time_window

  @@map("pricing_scope")
}

enum PricingModel {
  driver_set
  platform_computed

  @@map("pricing_model")
}

model PricingRateCard {
  id    BigInt       @id @default(autoincrement())
  scope PricingScope @default(global)

  // Set only when scope = vehicle_type
  vehicleTypeId BigInt? @map("vehicle_type_id")
  // Set only when scope = company (negotiated corporate rate)
  companyId     String? @map("company_id") @db.Uuid
  // Set only when scope = time_window — mirrors RidePolicy's day/time shape
  daysOfWeek    Int[]   @default([]) @map("days_of_week") // 1=Mon..7=Sun; empty = every day
  timeFrom      String? @map("time_from") // "HH:MM" in Africa/Lagos
  timeTo        String? @map("time_to")

  // Factors (NGN unless noted)
  baseFare            Decimal? @map("base_fare") @db.Decimal(15, 2)
  farePerKm           Decimal? @map("fare_per_km") @db.Decimal(15, 2)
  farePerMin          Decimal? @map("fare_per_min") @db.Decimal(15, 2)
  minFareFloor        Decimal? @map("min_fare_floor") @db.Decimal(15, 2)
  driverEarningsFloor Decimal? @map("driver_earnings_floor") @db.Decimal(15, 2)
  commissionRate      Decimal? @map("commission_rate") @db.Decimal(5, 2)
  surgeMultiplier     Decimal? @map("surge_multiplier") @db.Decimal(5, 2)

  // Versioning — rows are superseded, never edited in place
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")

  createdById BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicleType VehicleType?             @relation(fields: [vehicleTypeId], references: [id])
  company     Company?                 @relation(fields: [companyId], references: [id])
  createdBy   AdminUser                @relation(fields: [createdById], references: [id])
  changeLog   PricingFactorChangeLog[]

  @@index([scope, isActive])
  @@index([vehicleTypeId, isActive])
  @@index([companyId, isActive])
  @@map("pricing_rate_cards")
}

/// Audit trail for every factor edit a super-admin makes — required so a
/// disputed fare can be traced back to exactly who changed what and why.
model PricingFactorChangeLog {
  id           BigInt   @id @default(autoincrement())
  rateCardId   BigInt   @map("rate_card_id")
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  reason       String?
  changedById  BigInt   @map("changed_by")
  changedAt    DateTime @default(now()) @map("changed_at")

  rateCard  PricingRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  changedBy AdminUser       @relation(fields: [changedById], references: [id])

  @@index([rateCardId, changedAt(sort: Desc)])
  @@map("pricing_factor_change_log")
}

/// Admin-entered samples of what competitors (Uber/Bolt/inDrive) charge on
/// comparable trips — kept entirely separate from PricingRateCard so a
/// savings report is never computed against CC Ride's own fare formula.
model MarketBenchmarkRate {
  id             BigInt   @id @default(autoincrement())
  vehicleTypeId  BigInt?  @map("vehicle_type_id")
  distanceBandKm String   @map("distance_band_km") // e.g. "0-5", "5-10", "10-20"
  competitor     String? // "uber" | "bolt" | "indrive" | null = blended average
  sampledFare    Decimal  @map("sampled_fare") @db.Decimal(15, 2)
  sampledAt      DateTime @map("sampled_at")
  source         String   @default("manual")
  isActive       Boolean  @default(true) @map("is_active") // latest sample per band supersedes older ones
  enteredById    BigInt   @map("entered_by")
  createdAt      DateTime @default(now()) @map("created_at")

  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  enteredBy   AdminUser    @relation(fields: [enteredById], references: [id])

  @@index([distanceBandKm, isActive])
  @@map("market_benchmark_rates")
}

// =============================================================================
// CORPORATE SAVINGS & ANALYTICS
//
// Every corporate booking (pool or own-car) gets a shadow-priced record at
// completion, purely for reporting — it never affects what's actually
// charged. This is how a company sees "CC Ride saved you ₦X this month"
// without that number ever touching the live fare calculation.
// =============================================================================

model RideSavingsRecord {
  id         BigInt  @id @default(autoincrement())
  bookingId  String  @unique @map("booking_id") @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  employeeId BigInt? @map("employee_id")

  computedFairFare        Decimal  @map("computed_fair_fare") @db.Decimal(15, 2) // CC Ride's own formula output
  computedMarketBenchmark Decimal? @map("computed_market_benchmark") @db.Decimal(15, 2) // looked up from MarketBenchmarkRate
  actualOrgCost           Decimal  @map("actual_org_cost") @db.Decimal(15, 2) // this ride's amortized share of what the company actually paid
  driverPointsAwarded     Int      @default(0) @map("driver_points_awarded")

  distanceKm      Decimal? @map("distance_km") @db.Decimal(8, 2)
  durationMinutes Int?     @map("duration_minutes")
  rideDate        DateTime @map("ride_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company  Company          @relation(fields: [companyId], references: [id])
  employee CompanyEmployee? @relation(fields: [employeeId], references: [id])

  @@index([companyId, rideDate])
  @@map("ride_savings_records")
}

enum SavingsReportStatus {
  draft
  sent
  archived

  @@map("savings_report_status")
}

/// Generated monthly per company — total_savings is always
/// total_market_benchmark_cost - total_org_spend, never derived from
/// CC Ride's internal fare formula, so the figure holds up in a renewal
/// conversation with the client's finance team.
model CorporateSavingsReport {
  id          BigInt   @id @default(autoincrement())
  companyId   String   @map("company_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  totalRides               Int     @map("total_rides")
  totalMarketBenchmarkCost Decimal @map("total_market_benchmark_cost") @db.Decimal(15, 2)
  totalOrgSpend            Decimal @map("total_org_spend") @db.Decimal(15, 2)
  totalSavings             Decimal @map("total_savings") @db.Decimal(15, 2)
  savingsPercentage        Decimal @map("savings_percentage") @db.Decimal(5, 2)

  status        SavingsReportStatus @default(draft)
  pdfUrl        String?             @map("pdf_url")
  generatedById BigInt              @map("generated_by")
  generatedAt   DateTime            @default(now()) @map("generated_at")

  company     Company   @relation(fields: [companyId], references: [id])
  generatedBy AdminUser @relation(fields: [generatedById], references: [id])

  @@index([companyId, periodStart])
  @@map("corporate_savings_reports")
}
