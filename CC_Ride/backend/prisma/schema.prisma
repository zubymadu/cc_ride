  @@map("budgets")
}

model BudgetTransaction {
  id           BigInt   @id @default(autoincrement())
  budgetId     BigInt   @map("budget_id")
  bookingId    String?  @map("booking_id") @db.Uuid
  employeeId   String?  @map("employee_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  description  String
  transactedAt DateTime @default(now()) @map("transacted_at")

  budget  Budget   @relation(fields: [budgetId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("budget_transactions")
}

// =============================================================================
// APPROVAL WORKFLOWS
// =============================================================================

model ApprovalWorkflow {
  id                   BigInt       @id @default(autoincrement())
  companyId            String       @map("company_id") @db.Uuid
  branchId             BigInt?      @map("branch_id")
  departmentId         BigInt?      @map("department_id")
  name                 String
  requiresApproval     Boolean      @default(true) @map("requires_approval")
  autoApproveBelow     Decimal?     @map("auto_approve_below") @db.Decimal(15, 2)
  approverRole         EmployeeRole @default(manager) @map("approver_role")
  specificApproverId   String?      @map("specific_approver_id") @db.Uuid
  escalationHours      Int          @default(2) @map("escalation_hours")
  escalationApproverId String?      @map("escalation_approver_id") @db.Uuid
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             CompanyBranch?    @relation(fields: [branchId], references: [id])
  department         Department?       @relation(fields: [departmentId], references: [id])
  specificApprover   User?             @relation("WorkflowApprover", fields: [specificApproverId], references: [id])
  escalationApprover User?             @relation("WorkflowEscalation", fields: [escalationApproverId], references: [id])
  requests           ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalRequest {
  id                 BigInt         @id @default(autoincrement())
  workflowId         BigInt         @map("workflow_id")
  bookingId          String         @map("booking_id") @db.Uuid
  requesterId        String         @map("requester_id") @db.Uuid
  approverId         String?        @map("approver_id") @db.Uuid
  // Snapshot for approver display
  originAddress      String         @map("origin_address")
  destinationAddress String         @map("destination_address")
  estimatedFare      Decimal        @map("estimated_fare") @db.Decimal(15, 2)
  scheduledAt        DateTime       @map("scheduled_at")
  // Decision
  status             ApprovalAction @default(pending)
  decisionNote       String?        @map("decision_note")
  decidedAt          DateTime?      @map("decided_at")
  // Escalation
