// =============================================================================
// CC Ride — Prisma Schema
// Database : PostgreSQL 15+
// ORM      : Prisma 5.x
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// =============================================================================
// ENUMS
// =============================================================================

enum RideStatus {
  pending
  driver_assigned
  driver_en_route
  in_progress
  completed
  cancelled

  @@map("ride_status")
}

enum BookingStatus {
  pending
  confirmed
  processing
  in_progress
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingMethod {
  instant
  scheduled

  @@map("booking_method")
}

enum UserStatus {
  active
  suspended
  pending_verification
  banned

  @@map("user_status")
}

enum DriverStatus {
  pending
  active
  suspended
  offline
  on_trip
  rejected

  @@map("driver_status")
}

enum VehicleStatus {
  pending
  approved
  rejected
  inactive

  @@map("vehicle_status")
}

enum DocumentStatus {
  pending
  approved
  rejected
  expired

  @@map("document_status")
}

// Payout statuses — 'paid' is an alias kept for legacy controller compatibility
enum PayoutStatus {
  pending
  processing
  paid // alias for completed; retained for controller compatibility
  completed
  failed
  reversed

  @@map("payout_status")
}

enum PayoutMethod {
  paystack
  flutterwave
  bank_transfer

  @@map("payout_method")
}

enum PaymentGateway {
  paystack
  flutterwave
  company_account // corporate rides charged to company budget

  @@map("payment_gateway")
}

enum PaymentStatus {
  pending
  successful
  failed
  reversed
  refunded

  @@map("payment_status")
}

enum RideScheduleType {
  one_time
  recurring_daily
  recurring_weekly

  @@map("ride_schedule_type")
}

enum ApprovalAction {
  pending
  approved
  rejected
  escalated

  @@map("approval_action")
}

enum BudgetPeriodType {
  monthly
  quarterly
  annual

  @@map("budget_period_type")
}

enum CompanyStatus {
  active
  suspended
  pending_approval
  inactive
  rejected // company application rejected by super-admin

  @@map("company_status")
}

enum EmployeeRole {
  employee
  manager
  company_admin
  company_finance
  company_hr

  @@map("employee_role")
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  medium
  high
  urgent

  @@map("ticket_priority")
}

enum NotificationType {
  booking_confirmed
  driver_assigned
  driver_arrived
  ride_started
  ride_completed
  payment_processed
  approval_required
  approval_decided
  budget_alert
  general

  @@map("notification_type")
}

// =============================================================================
// PLATFORM ADMINISTRATION
// =============================================================================

/// Super-admin accounts that access the operations panel.
/// Referenced by controllers as `prisma.adminUser`.
model AdminUser {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  // Nullable — an invited-but-not-yet-claimed company admin has no
  // credentials until they follow their invite link and set one.
  passwordHash String?   @map("password_hash")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Scope — null = platform super-admin; set = company/branch admin
  scopeCompanyId String? @map("scope_company_id") @db.Uuid
  scopeBranchId  BigInt? @map("scope_branch_id")

  // Invite/claim flow — set when a company is approved (or a branch admin
  // is provisioned) and cleared once the invite is claimed. A null
  // inviteToken with a null passwordHash should never happen outside the
  // brief create-then-invite window; the claim endpoint is what clears both
  // together.
  inviteToken     String?   @unique @map("invite_token")
  inviteExpiresAt DateTime? @map("invite_expires_at")

  // Relations
  reviewedDocuments  DriverDocument[]
  assignedTickets    SupportTicket[]
  onboardedCompanies Company[]
  generatedInvoices  Invoice[]
  companyCredits     CompanyCredit[]
  branchCredits      BranchCredit[]
  scopeCompany       Company?         @relation("CompanyAdmins", fields: [scopeCompanyId], references: [id])
  scopeBranch        CompanyBranch?   @relation("BranchAdmins", fields: [scopeBranchId], references: [id])

  // Pricing & savings reporting
  createdRateCards        PricingRateCard[]
  rateCardChanges         PricingFactorChangeLog[]
  enteredBenchmarks       MarketBenchmarkRate[]
  generatedSavingsReports CorporateSavingsReport[]
  createdPoolSharingAgreements PoolSharingAgreement[]
  decidedAccessRequests   EmployeeAccessRequest[]

  @@map("admin_users")
}

/// Global platform configuration — always a single row (id = 1).
model PlatformSettings {
  id Int @id @default(1)

  // Branding
  appName    String  @default("CC Ride") @map("app_name")
  appLogoUrl String? @map("app_logo_url")

  // Localisation
  timezone       String @default("Africa/Lagos")
  currency       String @default("NGN")
  currencySymbol String @default("₦") @map("currency_symbol")

  // Finance
  platformCommission    Decimal @default(15.00) @map("platform_commission") @db.Decimal(5, 2)
  bookingFee            Decimal @default(100.00) @map("booking_fee") @db.Decimal(15, 2)
  minPayoutAmount       Decimal @default(5000.00) @map("min_payout_amount") @db.Decimal(15, 2)
  driverPayoutThreshold Decimal @default(5000.00) @map("driver_payout_threshold") @db.Decimal(15, 2)
  referralBonus         Decimal @default(500.00) @map("referral_bonus") @db.Decimal(15, 2)
  signupBonus           Decimal @default(0.00) @map("signup_bonus") @db.Decimal(15, 2)
  // Flat points credited per completed trip for corporate pool drivers
  // (companyId-owned vehicle), instead of cash — not tied to fare.
  pointsPerTrip         Int     @default(10) @map("points_per_trip")

  // Ride rules
  maxCancellationMinutes Int     @default(5) @map("max_cancellation_minutes")
  surgeMultiplierMax     Decimal @default(2.5) @map("surge_multiplier_max") @db.Decimal(5, 2)

  // Pricing model — driver_set: driver freely sets the fare when posting a
  // ride (the long-standing default). platform_computed: the platform
  // computes a fare from base_fare/fare_per_km/fare_per_min below (or a
  // more specific PricingRateCard override, same resolution order as
  // everywhere else in the engine) for NON-shared/ad-hoc rides — shown to
  // the driver as a suggested price and to the passenger as the expected
  // fare before booking. Shared/carpool routes stay driver-set either way;
  // splitting a route's already-fixed cost among riders isn't something a
  // per-km formula applies to.
  pricingModel        PricingModel @default(driver_set) @map("pricing_model")
  defaultBaseFare      Decimal     @default(500.00) @map("default_base_fare") @db.Decimal(15, 2)
  defaultFarePerKm     Decimal     @default(150.00) @map("default_fare_per_km") @db.Decimal(15, 2)
  defaultFarePerMin    Decimal     @default(10.00)  @map("default_fare_per_min") @db.Decimal(15, 2)

  // App mode
  maintenanceMode Boolean @default(false) @map("maintenance_mode")

  // Support contact
  supportEmail String? @map("support_email")
  supportPhone String? @map("support_phone")

  // Paystack
  paystackPublicKey String? @map("paystack_public_key")
  paystackSecretKey String? @map("paystack_secret_key")

  // Flutterwave
  flutterwavePublicKey String? @map("flutterwave_public_key")
  flutterwaveSecretKey String? @map("flutterwave_secret_key")
  flutterwaveEncKey    String? @map("flutterwave_enc_key")

  // Google Maps (key stored masked for settings page display)
  googleMapsKey       String? @map("google_maps_key")
  googleMapsKeyMasked String? @map("google_maps_key_masked")

  // Firebase / Push
  fcmServerKey      String? @map("fcm_server_key")
  firebaseProjectId String? @map("firebase_project_id")

  // OneSignal (alternative push)
  onesignalAppId       String? @map("onesignal_app_id")
  onesignalAppIdMasked String? @map("onesignal_app_id_masked")
  onesignalApiKey      String? @map("onesignal_api_key")

  // SMTP
  smtpHost      String? @map("smtp_host")
  smtpPort      Int?    @map("smtp_port")
  smtpUsername  String? @map("smtp_username")
  smtpPassword  String? @map("smtp_password")
  smtpFromEmail String? @map("smtp_from_email")

  // SMS (Termii / Africa's Talking)
  smsApiKey   String? @map("sms_api_key")
  smsSenderId String? @map("sms_sender_id")

  // App store links
  iosAppUrl     String? @map("ios_app_url")
  androidAppUrl String? @map("android_app_url")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Announcement/advert cards shown in the swipeable carousel on the app's
// home screen (both passenger and driver) — super-admin managed, no
// per-company scoping (a company-specific promo would live in the
// corporate module instead, this is platform-wide).
model Advert {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageUrl  String   @map("image_url")
  title     String
  body      String?
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("adverts")
}

model ApiRateLimit {
  id            BigInt    @id @default(autoincrement())
  identifier    String
  endpoint      String
  attempts      Int       @default(1)
  lastAttemptAt DateTime  @default(now()) @map("last_attempt_at")
  blockedUntil  DateTime? @map("blocked_until")

  @@unique([identifier, endpoint])
  @@map("api_rate_limits")
}

// =============================================================================
// USERS & DRIVER PROFILES
// =============================================================================

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String?    @unique
  mobile            String
  countryCode       String     @default("+234") @map("country_code")
  // Government identity anchor — never mobile, which a person can
  // legitimately have more than one of (a personal number and a separate
  // employer-issued one). Exactly one of these two applies to any person,
  // never both: NIN for a Nigerian, passport number otherwise. Optional
  // for an ordinary passenger; required (one or the other) for a driver or
  // a corporate employee, enforced at the registration endpoints rather
  // than a DB constraint, since the same column serves all three.
  nin               String?    @unique
  passportNumber    String?    @unique @map("passport_number")
  passwordHash      String     @map("password_hash")
  profilePicUrl     String?    @map("profile_pic_url")
  dateOfBirth       DateTime?  @map("date_of_birth") @db.Date
  bio               String?
  walletBalance     Decimal    @default(0.00) @map("wallet_balance") @db.Decimal(15, 2)
  isMobileVerified  Boolean    @default(false) @map("is_mobile_verified")
  isEmailVerified   Boolean    @default(false) @map("is_email_verified")
  emailOtpCode      String?    @map("email_otp_code")
  emailOtpExpiresAt DateTime?  @map("email_otp_expires_at")
  isDriver          Boolean    @default(false) @map("is_driver")
  status            UserStatus @default(pending_verification)
  referralCode      String?    @unique @map("referral_code")
  referredById      String?    @map("referred_by") @db.Uuid
  fcmToken          String?    @map("fcm_token")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  lastActiveAt      DateTime?  @map("last_active_at")

  // First-access invite (e.g. an org admin registering an employee) — the
  // account is created with an unguessable random passwordHash the user
  // never sees; this token is what actually gates setting a real password,
  // so passwordHash never needs to become nullable here (unlike AdminUser,
  // this table is touched by far more of the legacy codebase — safer to
  // keep it always-populated and gate access via the token instead).
  inviteToken     String?   @unique @map("invite_token")
  inviteExpiresAt DateTime? @map("invite_expires_at")

  // Self-referential
  referredBy    User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers User[] @relation("UserReferrals")

  // Driver
  driverProfile          DriverProfile?
  ridesAsDriver          Ride[]                    @relation("RideDriver")
  vehicles               Vehicle[]
  bankAccounts           DriverBankAccount[]
  payoutRequests         PayoutRequest[]
  poolVehicleAccess      DriverVehicleAccess[]
  pointsTransactions     DriverPointsTransaction[]
  routeSchedulesAsDriver RouteSchedule[]
  rideWaitlistEntries    RideWaitlist[]

  // Passenger
  bookings         Booking[]     @relation("BookingPassenger")
  bookingsAsDriver Booking[]     @relation("BookingDriver")
  rideRequests     RideRequest[]

  // Finance
  walletTransactions WalletTransaction[]
  couponRedemptions  CouponRedemption[]

  // Ratings
  driverRatingsGiven    DriverRating[] @relation("RatingPassenger")
  driverRatingsReceived DriverRating[] @relation("RatingDriver")

  // Other
  notifications  Notification[]
  supportTickets SupportTicket[]

  // Corporate
  companyMemberships CompanyEmployee[]
  createdBudgets     Budget[]          @relation("BudgetCreator")
  createdPolicies    RidePolicy[]      @relation("PolicyCreator")

  approvalWorkflowsAsApprover   ApprovalWorkflow[] @relation("WorkflowApprover")
  approvalWorkflowsAsEscalation ApprovalWorkflow[] @relation("WorkflowEscalation")
  approvalRequestsMade          ApprovalRequest[]  @relation("ApprovalRequester")
  approvalRequestsToDecide      ApprovalRequest[]  @relation("ApprovalDecider")
  approvalRequestsEscalatedTo   ApprovalRequest[]  @relation("ApprovalEscalation")

  receiptsAsEmployee RideReceipt[]

  @@unique([mobile, countryCode])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model DriverProfile {
  userId        String       @id @map("user_id") @db.Uuid
  licenseNumber String       @map("license_number")
  licenseExpiry DateTime     @map("license_expiry") @db.Date
  nin           String?
  bvn           String?
  status        DriverStatus @default(pending)
  averageRating Decimal      @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalTrips    Int          @default(0) @map("total_trips")
  totalEarnings Decimal      @default(0.00) @map("total_earnings") @db.Decimal(15, 2)
  // Corporate pool driver points — informational only, orgs manage rewards
  // for this at their own discretion; not redeemable in-app.
  pointsBalance Int          @default(0) @map("points_balance")

  // Current location (updated via Socket.IO)
  currentLocationLat Decimal?  @map("current_location_lat") @db.Decimal(10, 7)
  currentLocationLng Decimal?  @map("current_location_lng") @db.Decimal(10, 7)
  lastLocationAt     DateTime? @map("last_location_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DriverDocument[]

  @@map("driver_profiles")
}

model DriverDocument {
  id            BigInt         @id @default(autoincrement())
  driverId      String         @map("driver_id") @db.Uuid
  documentType  String         @map("document_type")
  fileUrl       String         @map("file_url")
  status        DocumentStatus @default(pending)
  rejectionNote String?        @map("rejection_note")
  expiresAt     DateTime?      @map("expires_at") @db.Date
  reviewedById  BigInt?        @map("reviewed_by")
  reviewedAt    DateTime?      @map("reviewed_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  driver     DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  reviewedBy AdminUser?    @relation(fields: [reviewedById], references: [id])

  @@map("driver_documents")
}

/// Driver bank accounts — separate model so a driver can have multiple accounts
/// and payouts can include { bankAccount { bankName, accountNumber } }.
model DriverBankAccount {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId              String   @map("driver_id") @db.Uuid
  bankName              String   @map("bank_name")
  bankCode              String?  @map("bank_code") // e.g. '058' for GTBank — required for Flutterwave transfers
  accountNumber         String   @map("account_number")
  accountName           String   @map("account_name")
  paystackRecipientCode String?  @map("paystack_recipient_code")
  isPrimary             Boolean  @default(true) @map("is_primary")
  createdAt             DateTime @default(now()) @map("created_at")

  driver  User            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  payouts PayoutRequest[]

  @@unique([driverId, accountNumber])
  @@map("driver_bank_accounts")
}

// =============================================================================
// VEHICLES
// =============================================================================

model VehicleType {
  id     BigInt  @id @default(autoincrement())
  title  String  @unique
  status Boolean @default(true)

  vehicles       Vehicle[]
  policies       RidePolicy[]
  rateCards      PricingRateCard[]
  benchmarkRates MarketBenchmarkRate[]

  @@map("vehicle_types")
}

model VehicleModel {
  id     BigInt  @id @default(autoincrement())
  title  String  @unique
  status Boolean @default(true)

  vehicles Vehicle[]

  @@map("vehicle_models")
}

model VehicleColor {
  id     BigInt  @id @default(autoincrement())
  title  String  @unique
  status Boolean @default(true)

  vehicles Vehicle[]

  @@map("vehicle_colors")
}

model Vehicle {
  id           BigInt        @id @default(autoincrement())
  // Nullable: a pool vehicle (companyId set) isn't owned by any one driver —
  // who's currently driving it is tracked separately via DriverVehicleAccess.
  driverId     String?       @map("driver_id") @db.Uuid
  // Non-null ⇒ this is an organisation-owned pool vehicle rather than a
  // personal vehicle. A vehicle is exactly one or the other, never both.
  companyId    String?       @map("company_id") @db.Uuid
  // Which branch of the owning company operates this pool vehicle — only
  // meaningful when companyId is set. Nullable so existing/company-level
  // pool vehicles keep working unchanged; branch-scoped sharing agreements
  // (see PoolSharingAgreement) only apply to vehicles that have this set.
  branchId     BigInt?       @map("branch_id")
  modelId      BigInt        @map("model_id")
  typeId       BigInt        @map("type_id")
  colorId      BigInt        @map("color_id")
  year         Int           @db.SmallInt
  licensePlate String        @unique @map("license_plate")
  photoUrl     String?       @map("photo_url")
  seatCapacity Int           @default(4) @map("seat_capacity") @db.SmallInt
  status       VehicleStatus @default(pending)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  driver             User?                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  company            Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             CompanyBranch?        @relation(fields: [branchId], references: [id])
  model              VehicleModel          @relation(fields: [modelId], references: [id])
  type               VehicleType           @relation(fields: [typeId], references: [id])
  color              VehicleColor          @relation(fields: [colorId], references: [id])
  rides              Ride[]
  driverAccessGrants DriverVehicleAccess[]
  routeSchedules     RouteSchedule[]

  @@map("vehicles")
}

// =============================================================================
// RIDES & BOOKINGS
// =============================================================================

model Ride {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId     String  @map("driver_id") @db.Uuid
  vehicleId    BigInt? @map("vehicle_id")
  // Set when this ride is a lazily-generated occurrence of a fixed Route's
  // schedule (see Route below) — null for ordinary ad-hoc rides.
  routeId      String? @map("route_id") @db.Uuid
  // Set when this ride is a lazily-generated daily occurrence of an ad-hoc
  // recurring_daily ride the driver originally posted — null for the
  // original template ride and for ordinary one_time rides. Mirrors the
  // Route/routeId materialization pattern below, just without a separate
  // template model since an ad-hoc recurring ride's own row already serves
  // as the template.
  parentRideId String? @map("parent_ride_id") @db.Uuid

  // Route
  originAddress      String  @map("origin_address")
  originLat          Decimal @map("origin_lat") @db.Decimal(10, 7)
  originLng          Decimal @map("origin_lng") @db.Decimal(10, 7)
  destinationAddress String  @map("destination_address")
  destinationLat     Decimal @map("destination_lat") @db.Decimal(10, 7)
  destinationLng     Decimal @map("destination_lng") @db.Decimal(10, 7)

  // Schedule
  scheduleType RideScheduleType @default(one_time) @map("schedule_type")
  scheduledAt  DateTime         @map("scheduled_at")

  // Pricing (NGN)
  baseFare             Decimal  @map("base_fare") @db.Decimal(15, 2)
  farePerKm            Decimal? @map("fare_per_km") @db.Decimal(15, 2)
  estimatedDistanceKm  Decimal? @map("estimated_distance_km") @db.Decimal(8, 2)
  estimatedDurationMin Int?     @map("estimated_duration_min")

  // Capacity & preferences
  availableSeats Int      @map("available_seats") @db.SmallInt
  luggageAllowed String   @default("M") @map("luggage_allowed")
  restrictions   String[] @default([])
  tripNotes      String?  @map("trip_notes")
  // "Auto" bookings confirm and take a seat immediately (existing behaviour).
  // "Manual" bookings sit as a pending Booking until the driver explicitly
  // confirms or declines — the Flutter app has sent this as book_preference
  // on every post_trip.php call from the start, but until now nothing on the
  // backend ever read or acted on it.
  bookPreference String   @default("Auto") @map("book_preference")

  // Status & OTPs
  status     RideStatus @default(pending)
  pickupOtp  String     @map("pickup_otp")
  dropoffOtp String     @map("dropoff_otp")

  // Timestamps
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  driver             User           @relation("RideDriver", fields: [driverId], references: [id])
  vehicle            Vehicle?       @relation(fields: [vehicleId], references: [id])
  route              Route?         @relation(fields: [routeId], references: [id])
  parentRide         Ride?          @relation("RideRecurrence", fields: [parentRideId], references: [id])
  recurringInstances Ride[]         @relation("RideRecurrence")
  stops              RideStop[]
  tracking           RideTracking[]
  bookings           Booking[]
  waitlist           RideWaitlist[]
  matchedRequests    RideRequest[]

  @@index([driverId])
  @@index([status])
  @@index([scheduledAt])
  @@index([routeId, scheduledAt])
  @@index([parentRideId, scheduledAt])
  @@map("rides")
}

model RideStop {
  id        BigInt  @id @default(autoincrement())
  rideId    String  @map("ride_id") @db.Uuid
  stopOrder Int     @map("stop_order") @db.SmallInt
  address   String
  lat       Decimal @db.Decimal(10, 7)
  lng       Decimal @db.Decimal(10, 7)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@map("ride_stops")
}

// =============================================================================
// FIXED ROUTES — "Find Shared Route"
//
// A Route is a template (code, name, ordered stops, one or more recurring
// schedules). It never gets booked directly — at search time, legacyFindTrip
// lazily materializes an ordinary Ride (tagged with routeId) for whichever of
// a Route's schedules fall on the requested date, so the rest of the booking
// flow (RideStop, Booking, legacyBookSeat, the whole Flutter booking chain)
// works unchanged. Seat inventory is exhausted, then RideWaitlist kicks in.
// =============================================================================

model Route {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  name            String
  companyId       String?  @map("company_id") @db.Uuid // null = platform-wide route
  originName      String   @map("origin_name")
  originLat       Decimal  @map("origin_lat") @db.Decimal(10, 7)
  originLng       Decimal  @map("origin_lng") @db.Decimal(10, 7)
  destinationName String   @map("destination_name")
  destinationLat  Decimal  @map("destination_lat") @db.Decimal(10, 7)
  destinationLng  Decimal  @map("destination_lng") @db.Decimal(10, 7)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  company   Company?        @relation(fields: [companyId], references: [id])
  stops     RouteStop[]
  schedules RouteSchedule[]
  rides     Ride[]

  @@index([companyId])
  @@map("routes")
}

model RouteStop {
  id        BigInt  @id @default(autoincrement())
  routeId   String  @map("route_id") @db.Uuid
  stopOrder Int     @map("stop_order") @db.SmallInt
  name      String
  lat       Decimal @db.Decimal(10, 7)
  lng       Decimal @db.Decimal(10, 7)

  route           Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupBookings  Booking[] @relation("BookingPickupStop")
  dropoffBookings Booking[] @relation("BookingDropoffStop")

  @@map("route_stops")
}

model RouteSchedule {
  id             BigInt  @id @default(autoincrement())
  routeId        String  @map("route_id") @db.Uuid
  departureTime  String  @map("departure_time") // "06:15", 24h
  daysOfWeek     Int[]   @map("days_of_week") // 0=Sun .. 6=Sat
  driverId       String? @map("driver_id") @db.Uuid // assigned pool driver
  vehicleId      BigInt? @map("vehicle_id") // assigned pool vehicle
  seatCapacity   Int     @map("seat_capacity") @db.SmallInt
  fare           Decimal @db.Decimal(15, 2)
  isActive       Boolean @default(true) @map("is_active")
  // Propagated onto each materialized Ride (see materializeRouteRidesForDate)
  // — lets a driver opt a specific published route into requiring manual
  // approval instead of every booking auto-confirming.
  bookPreference String  @default("Auto") @map("book_preference")

  route   Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver  User?    @relation(fields: [driverId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([routeId])
  @@map("route_schedules")
}

model RideWaitlist {
  id             BigInt         @id @default(autoincrement())
  rideId         String         @map("ride_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  seatsRequested Int            @map("seats_requested") @db.SmallInt
  status         WaitlistStatus @default(waiting)
  createdAt      DateTime       @default(now()) @map("created_at")
  promotedAt     DateTime?      @map("promoted_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([rideId, createdAt])
  @@map("ride_waitlist")
}

enum WaitlistStatus {
  waiting
  promoted
  expired

  @@map("waitlist_status")
}

model RideTracking {
  id         BigInt   @id @default(autoincrement())
  rideId     String   @map("ride_id") @db.Uuid
  driverId   String   @map("driver_id") @db.Uuid
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt(sort: Desc)])
  @@map("ride_tracking")
}

model Booking {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId      String  @map("ride_id") @db.Uuid
  passengerId String  @map("passenger_id") @db.Uuid
  // Denormalised driver FK — mirrors ride.driverId for direct queries
  driverId    String? @map("driver_id") @db.Uuid

  // Corporate (nullable — personal bookings leave these null)
  companyId         String? @map("company_id") @db.Uuid
  branchId          BigInt? @map("branch_id")
  departmentId      BigInt? @map("department_id")
  costCentreId      BigInt? @map("cost_centre_id")
  // Denorm FK — set after approval request is created; no Prisma relation to avoid circular dep
  approvalRequestId BigInt? @map("approval_request_id")

  // Seats
  seatsBooked Int @default(1) @map("seats_booked") @db.SmallInt

  // Only meaningful when the underlying ride is route-based (ride.routeId set)
  pickupStopId  BigInt? @map("pickup_stop_id")
  dropoffStopId BigInt? @map("dropoff_stop_id")

  // Fares (NGN)
  subtotal           Decimal @db.Decimal(15, 2)
  couponDiscount     Decimal @default(0.00) @map("coupon_discount") @db.Decimal(15, 2)
  walletAmountUsed   Decimal @default(0.00) @map("wallet_amount_used") @db.Decimal(15, 2)
  totalAmount        Decimal @map("total_amount") @db.Decimal(15, 2)
  driverEarning      Decimal @map("driver_earning") @db.Decimal(15, 2)
  platformCommission Decimal @map("platform_commission") @db.Decimal(15, 2)
  bookingFee         Decimal @default(0.00) @map("booking_fee") @db.Decimal(15, 2)

  // Payment
  paymentGateway   PaymentGateway? @map("payment_gateway")
  paymentReference String?         @unique @map("payment_reference")
  paymentStatus    PaymentStatus   @default(pending) @map("payment_status")

  // Method & rating
  bookingMethod   BookingMethod @default(instant) @map("booking_method")
  passengerRating Int?          @map("passenger_rating") @db.SmallInt
  passengerReview String?       @map("passenger_review")

  // Status
  status BookingStatus @default(pending)

  // Timestamps
  startedAt          DateTime? @map("started_at")
  confirmedAt        DateTime? @map("confirmed_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  ride               Ride                      @relation(fields: [rideId], references: [id])
  passenger          User                      @relation("BookingPassenger", fields: [passengerId], references: [id])
  driver             User?                     @relation("BookingDriver", fields: [driverId], references: [id])
  company            Company?                  @relation(fields: [companyId], references: [id])
  branch             CompanyBranch?            @relation(fields: [branchId], references: [id])
  department         Department?               @relation(fields: [departmentId], references: [id])
  costCentre         CostCentre?               @relation(fields: [costCentreId], references: [id])
  pickupStop         RouteStop?                @relation("BookingPickupStop", fields: [pickupStopId], references: [id])
  dropoffStop        RouteStop?                @relation("BookingDropoffStop", fields: [dropoffStopId], references: [id])
  approvalRequests   ApprovalRequest[] // back-relation: find via prisma.approvalRequest.findFirst({ where: { bookingId } })
  receipt            RideReceipt?
  driverRating       DriverRating?
  budgetTransactions BudgetTransaction[]
  couponRedemption   CouponRedemption?
  walletTransactions WalletTransaction[]
  supportTickets     SupportTicket[]
  pointsTransactions DriverPointsTransaction[]
  savingsRecord      RideSavingsRecord?
  walletDebits       CompanyCredit[]

  @@index([passengerId])
  @@index([driverId])
  @@index([rideId])
  @@index([companyId])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bookings")
}

model RideRequest {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId        String   @map("passenger_id") @db.Uuid
  originAddress      String   @map("origin_address")
  originLat          Decimal  @map("origin_lat") @db.Decimal(10, 7)
  originLng          Decimal  @map("origin_lng") @db.Decimal(10, 7)
  destinationAddress String   @map("destination_address")
  destinationLat     Decimal  @map("destination_lat") @db.Decimal(10, 7)
  destinationLng     Decimal  @map("destination_lng") @db.Decimal(10, 7)
  departureDate      DateTime @map("departure_date") @db.Date
  seatsRequired      Int      @default(1) @map("seats_required") @db.SmallInt
  notes              String?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  // Set when a driver commits to a route/trip that fulfils this request
  // (see legacyPostTrip) — the request stays isActive (still needs the
  // passenger's action) until they explicitly confirm or decline the
  // match, rather than auto-closing the moment a driver shows interest.
  matchedRideId String? @map("matched_ride_id") @db.Uuid

  passenger   User  @relation(fields: [passengerId], references: [id])
  matchedRide Ride? @relation(fields: [matchedRideId], references: [id])

  @@index([isActive, departureDate])
  @@map("ride_requests")
}

// =============================================================================
// PAYMENTS & WALLET
// =============================================================================

model WalletTransaction {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  bookingId    String?  @map("booking_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 2) // positive = credit, negative = debit
  balanceAfter Decimal  @map("balance_after") @db.Decimal(15, 2)
  description  String
  reference    String?  @unique
  createdAt    DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@map("wallet_transactions")
}

/// Points ledger for corporate pool drivers — informational only, no
/// in-app redemption. Participating organisations use this at their own
/// discretion to reward pool drivers; mirrors WalletTransaction's shape.
model DriverPointsTransaction {
  id           BigInt   @id @default(autoincrement())
  driverId     String   @map("driver_id") @db.Uuid
  bookingId    String?  @map("booking_id") @db.Uuid
  points       Int // positive = credit, negative = adjustment
  balanceAfter Int      @map("balance_after")
  description  String
  createdAt    DateTime @default(now()) @map("created_at")

  driver  User     @relation(fields: [driverId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([driverId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@map("driver_points_transactions")
}

/// Grants a driver access to drive a specific organisation pool vehicle.
/// A driver may hold grants to zero, one, or several pool vehicles; they
/// pick which one they're using at the start of each trip (pool car
/// availability can change trip to trip).
model DriverVehicleAccess {
  id        BigInt    @id @default(autoincrement())
  vehicleId BigInt    @map("vehicle_id")
  driverId  String    @map("driver_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, driverId])
  @@index([driverId, isActive])
  @@map("driver_vehicle_access")
}

/// Driver payout requests — referenced as `prisma.payoutRequest` in controllers.
model PayoutRequest {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId         String       @map("driver_id") @db.Uuid
  bankAccountId    String?      @map("bank_account_id") @db.Uuid
  amount           Decimal      @db.Decimal(15, 2)
  method           PayoutMethod @default(paystack)
  status           PayoutStatus @default(pending)
  gatewayReference String?      @unique @map("gateway_reference")
  failureReason    String?      @map("failure_reason")
  requestedAt      DateTime     @default(now()) @map("requested_at")
  processedAt      DateTime?    @map("processed_at")
  completedAt      DateTime?    @map("completed_at")

  driver      User               @relation(fields: [driverId], references: [id])
  bankAccount DriverBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("payout_requests")
}

// =============================================================================
// COUPONS & PROMOTIONS
// =============================================================================

model Coupon {
  id            BigInt   @id @default(autoincrement())
  imageUrl      String?  @map("image_url")
  title         String
  code          String   @unique
  subtitle      String?
  description   String?
  expiresAt     DateTime @map("expires_at")
  minAmount     Decimal  @default(0.00) @map("min_amount") @db.Decimal(15, 2)
  discountValue Decimal  @map("discount_value") @db.Decimal(15, 2)
  isPercentage  Boolean  @default(false) @map("is_percentage")
  maxUses       Int?     @map("max_uses")
  usesCount     Int      @default(0) @map("uses_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id         BigInt   @id @default(autoincrement())
  couponId   BigInt   @map("coupon_id")
  userId     String   @map("user_id") @db.Uuid
  bookingId  String?  @unique @map("booking_id") @db.Uuid // one redemption per booking
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  coupon  Coupon   @relation(fields: [couponId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([couponId, userId])
  @@map("coupon_redemptions")
}

// =============================================================================
// RATINGS
// =============================================================================

model DriverRating {
  id          BigInt   @id @default(autoincrement())
  bookingId   String   @unique @map("booking_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  rating      Int      @db.SmallInt
  review      String?
  createdAt   DateTime @default(now()) @map("created_at")

  booking   Booking @relation(fields: [bookingId], references: [id])
  driver    User    @relation("RatingDriver", fields: [driverId], references: [id])
  passenger User    @relation("RatingPassenger", fields: [passengerId], references: [id])

  @@map("driver_ratings")
}

// =============================================================================
// SUPPORT
// =============================================================================

model SupportTicket {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  bookingId   String?        @map("booking_id") @db.Uuid
  subject     String
  description String
  category    String? // e.g. "payment", "driver", "app", "general"
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)
  assignedTo  BigInt?        @map("assigned_to")
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  booking  Booking?         @relation(fields: [bookingId], references: [id])
  assignee AdminUser?       @relation(fields: [assignedTo], references: [id])
  messages SupportMessage[]

  @@index([status, priority])
  @@map("support_tickets")
}

model SupportMessage {
  id         BigInt   @id @default(autoincrement())
  ticketId   String   @map("ticket_id") @db.Uuid
  // Flexible sender: user, admin, or system
  senderType String   @default("user") @map("sender_type") // 'user' | 'admin' | 'system'
  senderId   String?  @map("sender_id") // userId or adminId as string
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id     BigInt           @id @default(autoincrement())
  userId String           @map("user_id") @db.Uuid
  type   NotificationType
  title  String
  body   String
  data   Json?
  isRead Boolean          @default(false) @map("is_read")
  sentAt DateTime         @default(now()) @map("sent_at")
  readAt DateTime?        @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// =============================================================================
// CONTENT MANAGEMENT
// =============================================================================

model Faq {
  id        BigInt   @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

model ContentPage {
  id        BigInt   @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_pages")
}

// =============================================================================
// CORPORATE LAYER
// =============================================================================

model Company {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  registrationNumber    String?       @unique @map("registration_number")
  taxId                 String?       @map("tax_id")
  industry              String?
  logoUrl               String?       @map("logo_url")
  address               String?
  city                  String?
  state                 String        @default("Lagos")
  contactName           String        @map("contact_name")
  contactEmail          String        @unique @map("contact_email")
  contactPhone          String?       @map("contact_phone") // optional — some companies register without phone
  status                CompanyStatus @default(pending_approval)
  // Subscription
  monthlySubscription   Decimal       @default(50000.00) @map("monthly_subscription") @db.Decimal(15, 2)
  subscriptionActive    Boolean       @default(false) @map("subscription_active")
  subscriptionExpiresAt DateTime?     @map("subscription_expires_at")
  // Commission override (null = use platform default)
  commissionRate        Decimal?      @map("commission_rate") @db.Decimal(5, 2)
  // Prepaid wallet (credited by admin for direct payments)
  walletBalance         Decimal       @default(0.00) @map("wallet_balance") @db.Decimal(15, 2)

  // Meta
  onboardedById BigInt?  @map("onboarded_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  onboardedBy       AdminUser?               @relation(fields: [onboardedById], references: [id])
  departments       Department[]
  costCentres       CostCentre[]
  employees         CompanyEmployee[]
  bookings          Booking[]
  budgets           Budget[]
  approvalWorkflows ApprovalWorkflow[]
  ridePolicies      RidePolicy[]
  invoices          Invoice[]
  receipts          RideReceipt[]
  creditLedger      CompanyCredit[]
  regions           CompanyRegion[]
  branches          CompanyBranch[]
  adminUsers        AdminUser[]              @relation("CompanyAdmins")
  poolVehicles      Vehicle[]
  routes            Route[]
  rateCards         PricingRateCard[]
  savingsRecords    RideSavingsRecord[]
  savingsReports    CorporateSavingsReport[]
  poolPolicy        CompanyPoolPolicy?
  poolSharesOffered PoolSharingAgreement[]   @relation("PoolSharesOffered")
  poolSharesReceived PoolSharingAgreement[]  @relation("PoolSharesReceived")
  accessRequests    EmployeeAccessRequest[]

  @@map("companies")
}

// One row per company — governs whether Company A's own pool fleet can be
// booked by another participating organisation's employees, and the
// company-wide default usage ration per employee. Company A's pool cars
// only ever serve Company A's own employees unless BOTH allowExternalSharing
// is on AND a PoolSharingAgreement explicitly names the requesting company —
// exclusivity is the default, sharing is opt-in on two levels deliberately.
model CompanyPoolPolicy {
  id                   BigInt   @id @default(autoincrement())
  companyId            String   @unique @map("company_id") @db.Uuid
  allowExternalSharing Boolean  @default(false) @map("allow_external_sharing")
  // Company-wide default ration per employee — null means unlimited. A
  // specific employee's own override on CompanyEmployee (poolDailyLimit
  // etc.) takes precedence over these when set.
  dailyLimit           Int?     @map("daily_limit")
  weeklyLimit          Int?     @map("weekly_limit")
  monthlyLimit         Int?     @map("monthly_limit")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_pool_policies")
}

// One-directional: companyId is opening ITS OWN pool fleet to
// partnerCompanyId's employees. Not assumed to be reciprocal — Company A
// sharing with Company B doesn't imply B is sharing back, since a company
// may not even operate its own pool fleet.
model PoolSharingAgreement {
  id               BigInt   @id @default(autoincrement())
  companyId        String   @map("company_id") @db.Uuid
  // Nullable: applies to ALL of companyId's branches (the original,
  // company-wide behaviour) when unset. Set to a specific branch to scope
  // this agreement to only that branch's pool fleet — a Lagos branch can
  // share with a partner while an Abuja branch of the same company shares
  // with nobody, because it simply has no agreement naming it.
  branchId         BigInt?  @map("branch_id")
  partnerCompanyId String   @map("partner_company_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  createdById      BigInt   @map("created_by_id")

  company        Company        @relation("PoolSharesOffered", fields: [companyId], references: [id], onDelete: Cascade)
  branch         CompanyBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  partnerCompany Company        @relation("PoolSharesReceived", fields: [partnerCompanyId], references: [id], onDelete: Cascade)
  createdBy      AdminUser      @relation(fields: [createdById], references: [id])

  @@unique([companyId, branchId, partnerCompanyId])
  @@map("pool_sharing_agreements")
}

model CompanyRegion {
  id        BigInt   @id @default(autoincrement())
  companyId String   @map("company_id") @db.Uuid
  name      String // e.g. "South-West Zone", "North Central"
  code      String? // e.g. "SW", "NC"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branches CompanyBranch[]

  @@unique([companyId, name])
  @@map("company_regions")
}

model CompanyBranch {
  id               BigInt   @id @default(autoincrement())
  companyId        String   @map("company_id") @db.Uuid
  regionId         BigInt?  @map("region_id")
  name             String // e.g. "Victoria Island Branch"
  code             String? // unique shortcode per company
  address          String?
  city             String?
  state            String   @default("Lagos")
  contactName      String?  @map("contact_name")
  contactPhone     String?  @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  isHeadquarters   Boolean  @default(false) @map("is_headquarters")
  isActive         Boolean  @default(true) @map("is_active")
  // Optional independent billing wallet
  walletBalance    Decimal  @default(0.00) @map("wallet_balance") @db.Decimal(15, 2)
  // Optional independent billing flag
  billedSeparately Boolean  @default(false) @map("billed_separately")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  region            CompanyRegion?     @relation(fields: [regionId], references: [id])
  employees         CompanyEmployee[]
  bookings          Booking[]
  budgets           Budget[]
  ridePolicies      RidePolicy[]
  approvalWorkflows ApprovalWorkflow[]
  invoices          Invoice[]
  adminUsers        AdminUser[]        @relation("BranchAdmins")
  creditLedger      BranchCredit[]
  vehicles          Vehicle[]
  poolSharingAgreements PoolSharingAgreement[]

  @@unique([companyId, code])
  @@index([companyId, regionId])
  @@map("company_branches")
}

model BranchCredit {
  id            BigInt   @id @default(autoincrement())
  branchId      BigInt   @map("branch_id")
  amount        Decimal  @db.Decimal(15, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(15, 2)
  paymentMethod String   @map("payment_method")
  reference     String?
  note          String?
  creditedById  BigInt   @map("credited_by")
  createdAt     DateTime @default(now()) @map("created_at")

  branch     CompanyBranch @relation(fields: [branchId], references: [id])
  creditedBy AdminUser     @relation(fields: [creditedById], references: [id])

  @@index([branchId, createdAt(sort: Desc)])
  @@map("branch_credits")
}

model CompanyCredit {
  id            BigInt   @id @default(autoincrement())
  companyId     String   @map("company_id") @db.Uuid
  amount        Decimal  @db.Decimal(15, 2) // positive = credit, negative = debit
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(15, 2)
  paymentMethod String   @map("payment_method") // e.g. "bank_transfer", "cash", "cheque", "ride_payment"
  reference     String? // payment ref / cheque number
  note          String?
  // Nullable — an admin-initiated top-up always has one, but a ride-payment
  // debit is system-generated at booking time and traces back to the
  // booking itself instead (bookingId).
  creditedById  BigInt?  @map("credited_by")
  bookingId     String?  @map("booking_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  company    Company   @relation(fields: [companyId], references: [id])
  creditedBy AdminUser? @relation(fields: [creditedById], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@map("company_credits")
}

model Department {
  id        BigInt   @id @default(autoincrement())
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCentres       CostCentre[]
  employees         CompanyEmployee[]
  bookings          Booking[]
  budgets           Budget[]
  approvalWorkflows ApprovalWorkflow[]
  ridePolicies      RidePolicy[]
  receipts          RideReceipt[]

  @@unique([companyId, name])
  @@map("departments")
}

model CostCentre {
  id           BigInt   @id @default(autoincrement())
  companyId    String   @map("company_id") @db.Uuid
  departmentId BigInt?  @map("department_id")
  name         String
  code         String
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?       @relation(fields: [departmentId], references: [id])
  employees  CompanyEmployee[]
  bookings   Booking[]
  budgets    Budget[]
  receipts   RideReceipt[]

  @@unique([companyId, code])
  @@map("cost_centres")
}

model CompanyEmployee {
  id                BigInt       @id @default(autoincrement())
  companyId         String       @map("company_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  branchId          BigInt?      @map("branch_id")
  departmentId      BigInt?      @map("department_id")
  costCentreId      BigInt?      @map("cost_centre_id")
  role              EmployeeRole @default(employee)
  employeeNumber    String?      @map("employee_number")
  jobTitle          String?      @map("job_title")
  // The employer's official correspondence address for this employment —
  // deliberately separate from User.email, which is the person's own
  // account/login identity and may be a personal address (or none at all).
  // Registering someone by their work email must never create a duplicate,
  // disconnected account for a person who already has a personal one.
  workEmail         String?      @map("work_email")
  monthlySpendLimit Decimal?     @map("monthly_spend_limit") @db.Decimal(15, 2)
  isActive          Boolean      @default(true) @map("is_active")
  invitedAt         DateTime     @default(now()) @map("invited_at")
  joinedAt          DateTime?    @map("joined_at")
  deactivatedAt     DateTime?    @map("deactivated_at")

  // Whether this employee's own personal vehicle has been approved by their
  // organisation to be driven for cash earnings ("own-car driver" mode).
  // Separate from pool-car access (DriverVehicleAccess) — an employee may
  // have either, both, or neither.
  personalVehicleApproved Boolean @default(false) @map("personal_vehicle_approved")

  // Riding (not driving) the company's pool fleet — off by default, an
  // admin explicitly selects which employees may book a pool car at all.
  // Ration overrides null = fall back to CompanyPoolPolicy's company-wide
  // default for that period; both null = unlimited.
  poolAccessEnabled Boolean @default(false) @map("pool_access_enabled")
  poolDailyLimit    Int?    @map("pool_daily_limit")
  poolWeeklyLimit   Int?    @map("pool_weekly_limit")
  poolMonthlyLimit  Int?    @map("pool_monthly_limit")
  // When this employee is allowed to use pool-car access at all — empty
  // days + null times = no restriction (available whenever access itself
  // is enabled). Same convention as PricingRateCard's time_window scope.
  poolAccessDaysOfWeek Int[]   @default([]) @map("pool_access_days_of_week")
  poolAccessTimeFrom   String? @map("pool_access_time_from")
  poolAccessTimeTo     String? @map("pool_access_time_to")

  // Paying for a ride out of the company's own funds rather than the
  // employee's personal wallet/card — same off-by-default, admin-granted
  // shape as pool access, including its own availability window.
  walletAccessEnabled    Boolean @default(false) @map("wallet_access_enabled")
  walletAccessDaysOfWeek Int[]   @default([]) @map("wallet_access_days_of_week")
  walletAccessTimeFrom   String? @map("wallet_access_time_from")
  walletAccessTimeTo     String? @map("wallet_access_time_to")

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         CompanyBranch?          @relation(fields: [branchId], references: [id])
  department     Department?             @relation(fields: [departmentId], references: [id])
  costCentre     CostCentre?             @relation(fields: [costCentreId], references: [id])
  savingsRecords RideSavingsRecord[]
  accessRequests EmployeeAccessRequest[]

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([branchId])
  @@map("company_employees")
}

enum AccessRequestType {
  pool_car
  wallet_payment

  @@map("access_request_type")
}

enum AccessRequestStatus {
  pending
  approved
  denied

  @@map("access_request_status")
}

// An employee-initiated ask for their company admin to grant pool-car or
// company-wallet access — the admin can also grant either directly via the
// CompanyEmployee toggles above without a request ever existing; this model
// only tracks the ask/decide conversation, not the access itself.
model EmployeeAccessRequest {
  id          BigInt               @id @default(autoincrement())
  companyId   String               @map("company_id") @db.Uuid
  employeeId  BigInt               @map("employee_id")
  requestType AccessRequestType    @map("request_type")
  status      AccessRequestStatus  @default(pending)
  note        String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  decidedAt   DateTime?            @map("decided_at")
  decidedById BigInt?              @map("decided_by_id")
  decisionNote String?             @map("decision_note")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy AdminUser?      @relation(fields: [decidedById], references: [id])

  @@index([companyId, status])
  @@index([employeeId])
  @@map("employee_access_requests")
}

// =============================================================================
// BUDGETS
// =============================================================================

model Budget {
  id              BigInt           @id @default(autoincrement())
  companyId       String           @map("company_id") @db.Uuid
  branchId        BigInt?          @map("branch_id")
  departmentId    BigInt?          @map("department_id")
  costCentreId    BigInt?          @map("cost_centre_id")
  periodType      BudgetPeriodType @default(monthly) @map("period_type")
  periodStart     DateTime         @map("period_start") @db.Date
  periodEnd       DateTime         @map("period_end") @db.Date
  allocatedAmount Decimal          @map("allocated_amount") @db.Decimal(15, 2)
